# Copie ce fichier en .env et remplis-le. .env est ignore par git.
# En hebergement (Render), definis plutot ces variables dans le dashboard.

# Base Supabase ou sont ranges les agendas.
# Sans ces deux lignes, tout est enregistre dans le dossier local cache/.
SUPABASE_URL=
SUPABASE_KEY=

# Identifiants de l'ecole, utilises uniquement par update_planning.py.
# S'ils sont absents, le script les demande au clavier.
AURIGA_EMAIL=
AURIGA_PASSWORD=

# Port d'ecoute, si tu veux surcharger config.json.
# PORT=8787
